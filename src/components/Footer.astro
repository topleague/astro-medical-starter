---
const currentYear = new Date().getFullYear();
const links = [
  { label: 'Servicios', href: '#services' },
  { label: 'Sobre nosotros', href: '#about' },
  { label: 'Equipo', href: '#team' },
  { label: 'Contacto', href: '#contact' },
];
const legal = [
  { label: 'Política de privacidad', href: '/privacidad' },
  { label: 'Términos y condiciones', href: '/terminos' },
  { label: 'Política de cookies', href: '/cookies' },
];
---
<!-- @daruma-template: Astro Medical Starter · https://darumaproducciones.es -->


<footer class="footer">
  <div class="container">
    <div class="footer-inner">
      <a href="/" class="nav-logo" style="font-size:1.25rem;">MEDCLINIC</a>
      <nav style="display:flex;gap:2rem;flex-wrap:wrap;">
        {links.map(l => (
          <a href={l.href} style="font-size:0.875rem;color:#6b6b7a;text-decoration:none;transition:color 0.15s;" onmouseover="this.style.color='var(--color-text)'" onmouseout="this.style.color='var(--color-muted)'">{l.label}</a>
        ))}
      </nav>
      <a href="#contact" class="btn-accent" style="padding:0.6rem 1.25rem;font-size:0.8rem;">Pedir cita</a>
    </div>
    <hr class="section-divider" style="margin-block:1.5rem;" />
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;">
      <p style="font-size:0.8rem;color:#6b6b7a;">© {currentYear} MedClinic. Todos los derechos reservados. · Template por <a href="https://darumaproducciones.es/" target="_blank" rel="noopener" style="color:#6d56e8;text-decoration:none;font-weight:600;">Cris Culebras · Daruma</a></p>
      <nav style="display:flex;gap:1.5rem;flex-wrap:wrap;">
        {legal.map(l => (
          <a href={l.href} style="font-size:0.75rem;color:#6b6b7a;text-decoration:none;">{l.label}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>
