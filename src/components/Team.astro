---
const team = [
  {
    name: 'Dra. Sarah Mitchell',
    role: 'Genetista Jefe',
    bio: 'La Dra. Mitchell es la líder visionaria de MedClinic, supervisando toda la investigación genética e iniciativas diagnósticas.',
    photo: 'https://images.unsplash.com/photo-1594824476967-48c8b964273f?w=400&h=500&fit=crop&q=80', // TODO: /public/images/team-1.jpg · 400×500px
  },
  {
    name: 'Laura Anderson',
    role: 'Coordinadora de Atención al Paciente',
    bio: 'Laura desempeña un papel fundamental para garantizar que los pacientes reciban el apoyo y la orientación que necesitan durante todo su proceso.',
    photo: 'https://images.unsplash.com/photo-1559839734-2b71ea197ec2?w=400&h=500&fit=crop&q=80', // TODO: /public/images/team-2.jpg · 400×500px
  },
  {
    name: 'Dra. Emily Davis',
    role: 'Especialista Clínica',
    bio: 'La Dra. Davis interpreta datos genéticos para los pacientes, transformando hallazgos complejos en información accionable.',
    photo: 'https://images.unsplash.com/photo-1651008376811-b90baee60c1f?w=400&h=500&fit=crop&q=80', // TODO: /public/images/team-3.jpg · 400×500px
  },
  {
    name: 'Dr. James Park',
    role: 'Director de Investigación',
    bio: 'El Dr. Park guía los esfuerzos de investigación de MedClinic y las colaboraciones con instituciones académicas de todo el mundo.',
    photo: 'https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?w=400&h=500&fit=crop&q=80', // TODO: /public/images/team-4.jpg · 400×500px
  },
];
---
<!-- @daruma-template: Astro Medical Starter · https://darumaproducciones.es -->


<section id="team">
  <div class="container">
    <div class="team-header">
      <h2 class="display-md">Nuestro equipo</h2>
      <div style="display:flex;gap:0.5rem;">
        <button class="nav-icon-btn" id="teamPrev" aria-label="Anterior">‹</button>
        <button class="nav-icon-btn" id="teamNext" aria-label="Siguiente">›</button>
      </div>
    </div>

    <div class="team-track" id="teamTrack">
      {team.map((m, idx) => (
        <div class={`team-card${idx === 0 ? ' team-card--active' : ''}`} data-idx={idx}>

          <!-- Estado base: gris con nombre arriba y bio abajo -->
          <div class="team-card-base">
            <div class="team-card-info">
              <h3 class="team-name">{m.name}</h3>
              <p class="team-role">{m.role}</p>
            </div>
            <p class="team-bio">{m.bio}</p>
          </div>

          <!-- Hover/active: foto + tarjeta degradado encima -->
          <div class="team-card-hover">
            <img src={m.photo} alt={m.name} class="team-photo" loading="lazy" />
            <div class="team-hover-card">
              <h3 class="team-hover-name">{m.name}</h3>
              <p class="team-hover-role">{m.role}</p>
              <p class="team-hover-bio">{m.bio}</p>
            </div>
          </div>

        </div>
      ))}
    </div>
  </div>
</section>

<style>
.team-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 3rem;
}

.team-track {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.1rem;
}

/* Cada card */
.team-card {
  min-width: 0;
  border-radius: 1.25rem;
  min-height: 420px;
  position: relative;
  overflow: hidden;
  cursor: pointer;
}

/* Estado base */
.team-card-base {
  position: absolute;
  inset: 0;
  background: var(--color-surface);
  border-radius: 1.25rem;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: opacity 0.35s ease;
}
.team-name  { font-size: 1rem; font-weight: 700; margin-bottom: 0.2rem; }
.team-role  { font-size: 0.75rem; color: #6b6b7a; }
.team-bio   { font-size: 0.78rem; color: #6b6b7a; line-height: 1.6; }

/* Estado hover/active */
.team-card-hover {
  position: absolute;
  inset: 0;
  border-radius: 1.25rem;
  overflow: hidden;
  opacity: 0;
  transition: opacity 0.35s ease;
}
.team-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
}
/* Tarjeta degradado superpuesta sobre la foto */
.team-hover-card {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 1.25rem;
  background: linear-gradient(135deg, var(--color-grad-start), var(--color-grad-end));
  border-radius: 1.25rem;
  color: #fff;
  /* Solo ocupa la mitad inferior */
  top: 45%;
}
.team-hover-name { font-size: 1rem; font-weight: 700; margin-bottom: 0.2rem; }
.team-hover-role { font-size: 0.72rem; opacity: 0.8; margin-bottom: 0.6rem; }
.team-hover-bio  { font-size: 0.75rem; line-height: 1.55; opacity: 0.9; }

/* Activar hover */
.team-card:hover .team-card-base,
.team-card--active .team-card-base { opacity: 0; }

.team-card:hover .team-card-hover,
.team-card--active .team-card-hover { opacity: 1; }

/* Dot indicator */
.team-dot-wrap {
  display: flex;
  gap: 0.4rem;
  margin-top: 1.5rem;
}
</style>

<script>
  const track = document.getElementById('teamTrack') as HTMLElement;
  const prev  = document.getElementById('teamPrev') as HTMLButtonElement;
  const next  = document.getElementById('teamNext') as HTMLButtonElement;
  const cardW = 260 + 18;

  prev.addEventListener('click', () => track.scrollBy({ left: -cardW, behavior: 'smooth' }));
  next.addEventListener('click', () => track.scrollBy({ left:  cardW, behavior: 'smooth' }));
</script>
