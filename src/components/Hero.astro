<!-- @daruma-template: Astro Medical Starter · https://darumaproducciones.es -->


<!--
  HERO VIDEO: Coloca tu vídeo en /public/videos/dna-hero.webm
  Poster (primer frame): /public/videos/dna-poster.jpg
-->

<div id="hero-loader" aria-hidden="true">
  <div class="loader-logo">MEDCLINIC</div>
  <div class="loader-bar-track">
    <div class="loader-bar-fill" id="loaderBar"></div>
  </div>
</div>

<section id="hero" class="hero-section">

  <!-- Vídeo derecha -->
  <div class="hero-video-col" aria-hidden="true">
    <video id="heroVideo" autoplay muted loop playsinline preload="auto" poster="/videos/dna-poster.jpg">
      <source src="/videos/dna-hero.webm" type="video/webm" />
      <!-- Fallback MP4 para Safari: añade dna-hero.mp4 en public/videos/ y descomenta -->
      <!-- <source src="/videos/dna-hero.mp4" type="video/mp4" /> -->
    </video>
    <div class="hero-video-fade"></div>
  </div>

  <!-- Contenido -->
  <div class="container hero-inner">

    <div class="hero-copy">

      <p class="hero-eyebrow hero-animate" style="--delay:0.1s">Propósito de MedClinic</p>

      <h1 class="hero-h1 hero-animate" style="--delay:0.2s">
        Diagnóstico detallado<br/>de tu cuerpo
      </h1>

      <p class="hero-body hero-animate" style="--delay:0.35s">
        La salud es lo más importante. No lo dejes<br/>
        para después. Piensa en tu futuro hoy.
      </p>

      <div class="hero-animate" style="--delay:0.5s">
        <a href="#contact" class="hero-btn-outline">Pedir cita</a>
      </div>

    </div>

    <div class="hero-video-spacer" aria-hidden="true"></div>

  </div>

  <!-- Milestone strip inferior -->
  <div class="hero-milestone hero-animate" style="--delay:0.65s">
    <div class="container">
      <div class="milestone-inner">
        <span class="milestone-num">01</span>
        <div>
          <p class="milestone-date">2022-08-30</p>
          <p class="milestone-title">Primer Laboratorio Central en Investigación Clínica</p>
        </div>
        <p class="milestone-desc">
          MedClinic es un Laboratorio Central de Investigación Clínica Global especializado en Oncología e Investigación del Cáncer con acreditaciones de IAM y CLIA, en operación desde 2009.
        </p>
        <a href="#about" class="hero-scroll-cta hero-animate" style="--delay:0.6s">↓ Ver más</a>
      </div>
    </div>
  </div>

</section>

<style>
/* ── Loader ──────────────────────────────────────────────── */
#hero-loader {
  position: fixed;
  bottom: 2rem;
  right: 2rem;
  z-index: 9999;
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(8px);
  border: 1px solid var(--color-border);
  border-radius: 2rem;
  padding: 0.75rem 1.25rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  transition: opacity 0.4s ease, visibility 0.4s ease;
  box-shadow: 0 4px 20px rgba(0,0,0,0.08);
}
#hero-loader.hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}
.loader-logo {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--color-text);
}
.loader-bar-track {
  width: 80px;
  height: 2px;
  background: var(--color-border);
  border-radius: 2px;
  overflow: hidden;
}
.loader-bar-fill {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, var(--color-grad-start), var(--color-grad-end));
  border-radius: 2px;
  transition: width 0.1s linear;
}

/* ── Hero section ────────────────────────────────────────── */
.hero-section {
  position: relative;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-top: 5rem;
}

/* Vídeo */
.hero-video-col {
  position: absolute;
  top: 0;
  right: 0;
  width: 55%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}
.hero-video-col video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
}
.hero-video-fade {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to right,
    var(--color-bg) 0%,
    rgba(255,255,255,0.55) 38%,
    transparent 100%
  );
}

/* Grid interior */
.hero-inner {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
  flex: 1;
  padding-block: 4rem 3rem;
}
.hero-copy { max-width: 520px; }

/* ── Tipografía hero — ajustada a la captura ─────────────── */
.hero-eyebrow {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-text);
  margin-bottom: 1.25rem;
}

.hero-h1 {
  font-size: clamp(2.4rem, 4.5vw, 3.6rem);
  font-weight: 600;               /* menos bold que antes, más elegante */
  line-height: 1.08;
  letter-spacing: -0.025em;
  color: var(--color-text);
  margin-bottom: 2rem;
  max-width: 13ch;
}

.hero-body {
  font-size: 0.9rem;
  line-height: 1.65;
  color: var(--color-muted);
  margin-bottom: 2.75rem;
  max-width: 38ch;
}

/* Botón outline pill — más fino, sin uppercase */
.hero-btn-outline {
  display: inline-flex;
  align-items: center;
  padding: 0.65rem 1.4rem;
  border: 1.5px solid var(--color-text);
  border-radius: 9999px;
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--color-text);
  text-decoration: none;
  background: transparent;
  transition: background 0.2s, color 0.2s;
}
.hero-btn-outline:hover {
  background: var(--color-text);
  color: #fff;
}

/* Ver más — pastilla negra inline en la caja milestone */
.hero-scroll-cta {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.65rem 1.2rem;
  background: var(--color-text);
  color: #fff;
  border-radius: 9999px;
  font-size: 0.78rem;
  font-weight: 600;
  text-decoration: none;
  letter-spacing: 0.04em;
  white-space: nowrap;
  transition: opacity 0.2s;
  flex-shrink: 0;
}
.hero-scroll-cta:hover { opacity: 0.75; }

/* ── Milestone ───────────────────────────────────────────── */
.hero-milestone {
  position: relative;
  z-index: 1;
  padding: 1.5rem 0;
  margin-top: auto;
}
.milestone-inner {
  display: grid;
  grid-template-columns: auto 1fr auto auto;
  gap: 2rem;
  align-items: center;
  background: rgba(240, 240, 244, 0.72);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(200, 200, 210, 0.5);
  border-radius: var(--radius-card);
  padding: 1.75rem 2rem;
}
.milestone-num {
  font-size: 3rem;
  font-weight: 800;
  color: var(--color-text);
  line-height: 1;
}
.milestone-date {
  font-size: 0.72rem;
  color: var(--color-muted);
  margin-bottom: 0.35rem;
  font-weight: 500;
}
.milestone-title {
  font-size: 1rem;
  font-weight: 700;
  line-height: 1.3;
  max-width: 22ch;
}
.milestone-desc {
  max-width: 40ch;
  font-size: 0.82rem;
  color: var(--color-text);
  line-height: 1.65;
}

/* ── Animación entrada ───────────────────────────────────── */
.hero-animate {
  opacity: 0;
  transform: translateY(18px);
  transition:
    opacity 0.65s ease var(--delay, 0s),
    transform 0.65s ease var(--delay, 0s);
}
.hero-animate.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ── Mobile ──────────────────────────────────────────────── */
@media (max-width: 768px) {
  .hero-video-col { width: 100%; opacity: 0.2; }
  .hero-inner { grid-template-columns: 1fr; padding-block: 3rem 2rem; }
  .hero-video-spacer { display: none; }
  .hero-h1 { font-size: clamp(2rem, 8vw, 3rem); }
  .hero-scroll-cta { bottom: calc(140px + 1.5rem); right: 1.5rem; }
  .milestone-inner { grid-template-columns: auto 1fr; gap: 1.25rem; }
  .milestone-desc { display: none; }
}
</style>

<script>
  const loader    = document.getElementById('hero-loader') as HTMLElement;
  const loaderBar = document.getElementById('loaderBar') as HTMLElement;
  const heroSec   = document.getElementById('hero') as HTMLElement;
  const video     = document.getElementById('heroVideo') as HTMLVideoElement;
  const animEls   = document.querySelectorAll('.hero-animate');

  function revealHero() {
    loader.classList.add('hidden');
    animEls.forEach(el => el.classList.add('visible'));
  }

  let progress = 0;
  const barInterval = setInterval(() => {
    progress = Math.min(progress + Math.random() * 12, 90);
    loaderBar.style.width = progress + '%';
  }, 120);

  function onVideoReady() {
    clearInterval(barInterval);
    loaderBar.style.width = '100%';
    loaderBar.style.transition = 'width 0.3s ease';
    setTimeout(revealHero, 350);
  }

  // Animar el copy del hero inmediatamente (no espera al vídeo)
  document.addEventListener('DOMContentLoaded', () => {
    animEls.forEach(el => el.classList.add('visible'));
  });

  if (video) {
    video.addEventListener('canplaythrough', onVideoReady, { once: true });
    const fallbackTimer = setTimeout(onVideoReady, 1500);
    video.addEventListener('canplaythrough', () => clearTimeout(fallbackTimer), { once: true });
    if (video.readyState >= 4) onVideoReady();
  } else {
    setTimeout(onVideoReady, 500);
  }
</script>
