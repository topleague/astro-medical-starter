---
const stats = [
  { number: '14',   label: 'Años de experiencia' },
  { number: '39+',  label: 'Países atendidos' },
  { number: '99%',  label: 'Tasa de precisión' },
  { number: '25k+', label: 'Pacientes satisfechos' },
];

const features = [
  { title: 'Diagnósticos sin igual',      desc: 'Estamos a la vanguardia de la salud personalizada, ofreciendo capacidades diagnósticas incomparables.' },
  { title: 'Alcance global',              desc: 'Expansión continua para satisfacer las necesidades cambiantes de la salud en todo el mundo.' },
  { title: 'Excelencia en investigación', desc: 'Destacamos en el campo de la investigación oncológica, con acreditación de IAM y CLIA.' },
];

// TODO: sustituye por imagen propia · 600×800px · /public/images/about-cell.jpg
const IMG_CELL     = 'https://images.unsplash.com/photo-1576086213369-97a306d36557?w=600&q=80';
// TODO: sustituye por imagen propia · 500×500px · /public/images/about-molecule.jpg
const IMG_MOLECULE = 'https://images.unsplash.com/photo-1559757175-0eb30cd8c063?w=500&q=80';
// TODO: avatares del equipo · 80×80px · /public/images/avatar-1.jpg (etc.)
const AVATAR_1 = 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=32&h=32&fit=crop&q=80';
const AVATAR_2 = 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=32&h=32&fit=crop&q=80';
const AVATAR_3 = 'https://images.unsplash.com/photo-1580489944761-15a19d654956?w=32&h=32&fit=crop&q=80';
---
<!-- @daruma-template: Astro Medical Starter · https://darumaproducciones.es -->

<section id="about">
  <div class="container">

    <!-- ── Misión + Stats ─────────────────────────────────────── -->
    <div class="about-top">
      <div>
        <h2 class="about-mission">
          Nuestra misión es desvelar las complejidades de tu salud,
          ofreciéndote
          <span class="text-fade"> los diagnósticos más detallados y precisos.</span>
        </h2>
      </div>
      <div>
        <p class="text-eyebrow" style="margin-bottom:1.5rem;">Diagnósticos de Precisión MedClinic</p>
        <div class="stats-grid">
          {stats.map((s, i) => (
            <div class="stat-item stat-anim" style={`--i:${i}`}>
              <div class="stat-number-wrap">
                <div class="stat-number">{s.number}</div>
              </div>
              <div class="stat-label">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- ── Cards row ─────────────────────────────────────────── -->
    <div class="about-cards">

      <!-- Col 1: imagen grande -->
      <div class="about-card-img reveal-card" style="--cd:0s">
        <img src={IMG_CELL} alt="Célula 3D azul" class="about-cell-img" loading="lazy" width="600" height="800" />

        <div class="about-video-controls">
          <button aria-label="Pausar">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
          </button>
          <button aria-label="Reproducir">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </button>
        </div>

        <div class="about-team-badge">
          <div class="team-avatars">
            <img src={AVATAR_1} alt="" class="avatar-img" width="32" height="32" />
            <img src={AVATAR_2} alt="" class="avatar-img" width="32" height="32" />
            <img src={AVATAR_3} alt="" class="avatar-img" width="32" height="32" />
          </div>
          <div>
            <p class="badge-title">Conoce a nuestro<br/>equipo de expertos</p>
            <a href="#team" class="badge-btn">Explorar más</a>
          </div>
        </div>
      </div>

      <!-- Col 2+3: layout sincronizado -->
      <div class="about-right reveal-card" style="--cd:0.15s">

        <!-- Fila superior: intro+botón | molécula -->
        <div class="about-right-top">
          <div class="about-intro-col">
            <p class="about-col-intro">
              Impulsados por una rica historia de experiencia y una búsqueda incansable de la excelencia científica.
            </p>
            <a href="#services" class="btn-solid about-learn-btn">Saber más</a>
          </div>

          <!-- Molécula: más compacta -->
          <div class="mol-wrap">
            <div class="mol-img-container">
              <img src={IMG_MOLECULE} alt="Molécula 3D" class="mol-img" loading="lazy" />
              <button class="mol-question" aria-label="Más info">?</button>
            </div>
            <div class="mol-info-card">
              <p class="mol-info-title">Buena interacción<br/>con otras moléculas</p>
              <a href="#services" class="mol-learn-btn">Saber más</a>
            </div>
          </div>
        </div>

        <!-- Features: títulos más ligeros, sin borde entre col -->
        <div class="about-features">
          {features.map(f => (
            <div class="feature-row">
              <div class="feature-left">
                <span class="feature-icon">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="16"/>
                    <line x1="8" y1="12" x2="16" y2="12"/>
                  </svg>
                </span>
                <p class="feature-title">{f.title}</p>
              </div>
              <p class="feature-desc">{f.desc}</p>
            </div>
          ))}
        </div>

      </div>
    </div>
  </div>
</section>

<style>
/* ── Mission + Stats ─────────────────────────────────────── */
.about-top {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: start;
  margin-bottom: 3.5rem;
}
.about-mission {
  font-size: clamp(1.5rem, 2.8vw, 2.2rem);
  font-weight: 500;
  line-height: 1.18;
  letter-spacing: -0.02em;
  max-width: 24ch;
}
.stat-item {
  padding: 1.5rem 0;
  border-bottom: 1px solid var(--color-border);
  overflow: hidden;
}
.stat-item:nth-child(odd)  { border-right: 1px solid var(--color-border); padding-right: 2rem; }
.stat-item:nth-child(even) { padding-left: 2rem; }
.stat-number-wrap { overflow: hidden; line-height: 1; margin-bottom: 0.4rem; }
.stat-number {
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1;
  transform: translateY(110%);
  opacity: 0;
  transition: transform 0.7s cubic-bezier(0.16,1,0.3,1) calc(var(--i,0)*0.12s),
              opacity   0.4s ease                        calc(var(--i,0)*0.12s);
}
.stat-label {
  font-size: 0.8rem;
  color: var(--color-muted);
  opacity: 0;
  transform: translateY(6px);
  transition: opacity   0.5s ease calc(0.3s + var(--i,0)*0.12s),
              transform 0.5s ease calc(0.3s + var(--i,0)*0.12s);
}
.stat-anim.visible .stat-number { transform: translateY(0); opacity: 1; }
.stat-anim.visible .stat-label  { opacity: 1; transform: translateY(0); }

/* ── Cards grid ──────────────────────────────────────────── */
.about-cards {
  display: grid;
  grid-template-columns: 4fr 7fr;   /* col1 más estrecha */
  gap: 1.5rem;
  align-items: start;
}

/* ── Col 1: imagen grande ────────────────────────────────── */
.about-card-img {
  position: relative;
  border-radius: 1.75rem;
  overflow: hidden;
  background: #c8dce8;
}
.about-cell-img {
  width: 100%;
  aspect-ratio: 3/4;
  object-fit: cover;
  object-position: center;
  display: block;
}
.about-video-controls {
  position: absolute;
  top: 1rem;
  right: 1rem;
  display: flex;
  gap: 0.4rem;
  z-index: 2;
}
.about-video-controls button {
  width: 2.1rem;
  height: 2.1rem;
  border-radius: 50%;
  background: rgba(255,255,255,0.8);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text);
  backdrop-filter: blur(8px);
  transition: background 0.15s;
}
.about-video-controls button:hover { background: #fff; }
.about-team-badge {
  position: absolute;
  bottom: 1rem;
  left: 1rem;
  right: 2.5rem;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.8rem 1rem;
  border-radius: 1rem;
  background: rgba(255,255,255,0.55);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,0.45);
}
.team-avatars { display: flex; flex-shrink: 0; }
.avatar-img {
  width: 2rem;
  height: 2rem;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid rgba(255,255,255,0.8);
  margin-left: -0.55rem;
}
.avatar-img:first-child { margin-left: 0; }
.badge-title { font-size: 0.75rem; font-weight: 700; line-height: 1.3; color: var(--color-text); margin-bottom: 0.3rem; }
.badge-btn {
  display: inline-flex;
  padding: 0.28rem 0.8rem;
  border: 1.5px solid rgba(0,0,0,0.15);
  border-radius: 9999px;
  font-size: 0.65rem;
  font-weight: 600;
  color: var(--color-text);
  text-decoration: none;
  background: rgba(255,255,255,0.7);
}

/* ── Col derecha ─────────────────────────────────────────── */
.about-right { display: flex; flex-direction: column; gap: 0; }

.about-right-top {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  align-items: start;
  margin-bottom: 2rem;
}
.about-intro-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding-top: 0.25rem;
}
.about-col-intro {
  font-size: 0.875rem;
  line-height: 1.65;
  color: var(--color-muted);
  margin-bottom: 1.5rem;
  max-width: 28ch;
}
.about-learn-btn { align-self: flex-start; }

/* Molécula más compacta */
.mol-wrap { position: relative; }
.mol-img-container {
  position: relative;
  border-radius: 1.5rem;
  overflow: hidden;
  background: #dde0e3;
}
.mol-img {
  width: 100%;
  aspect-ratio: 1/1;
  object-fit: cover;
  display: block;
}
.mol-question {
  position: absolute;
  top: 50%;
  right: 0.9rem;
  transform: translateY(-50%);
  width: 1.9rem;
  height: 1.9rem;
  border-radius: 50%;
  background: rgba(255,255,255,0.82);
  border: none;
  cursor: pointer;
  font-weight: 700;
  font-size: 0.85rem;
  color: var(--color-text);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8px);
}
.mol-info-card {
  position: absolute;
  bottom: -0.75rem;
  left: 0.75rem;
  right: 1.5rem;
  z-index: 2;
  background: rgba(255,255,255,0.68);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(255,255,255,0.5);
  border-radius: 1rem;
  padding: 0.9rem 1rem 1rem;
}
.mol-info-title {
  font-size: 0.95rem;
  font-weight: 700;
  line-height: 1.25;
  margin-bottom: 0.55rem;
  color: var(--color-text);
}
.mol-learn-btn {
  display: inline-flex;
  padding: 0.3rem 0.85rem;
  background: var(--color-accent);
  color: #fff;
  border-radius: 9999px;
  font-size: 0.68rem;
  font-weight: 600;
  text-decoration: none;
}

/* ── Features — títulos más ligeros, como en captura ────── */
.about-features {
  display: flex;
  flex-direction: column;
  padding-top: 2.5rem;   /* espacio para mol-info-card que sobresale */
  border-top: 1px solid var(--color-border);
}
.feature-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  align-items: baseline;
  padding: 1rem 0;
  border-bottom: 1px solid var(--color-border);
}
.feature-row:last-child { border-bottom: none; }

.feature-left {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}
.feature-icon {
  width: 1.5rem;
  height: 1.5rem;
  border-radius: 50%;
  border: 1.5px solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-muted);
  flex-shrink: 0;
}
/* Título de feature: más ligero y grande — como en captura */
.feature-title {
  font-size: 1.15rem;
  font-weight: 500;       /* antes 700 — ahora más fino */
  line-height: 1.2;
  letter-spacing: -0.01em;
  color: var(--color-text);
}
.feature-desc {
  font-size: 0.8rem;
  color: var(--color-muted);
  line-height: 1.6;
}

/* ── Reveal scroll ───────────────────────────────────────── */
.reveal-card {
  opacity: 0;
  transform: translateY(44px);
  transition: opacity   0.8s cubic-bezier(0.16,1,0.3,1) var(--cd,0s),
              transform 0.8s cubic-bezier(0.16,1,0.3,1) var(--cd,0s);
}
.reveal-card.visible { opacity: 1; transform: translateY(0); }

/* ── Mobile ──────────────────────────────────────────────── */
@media (max-width: 900px) {
  .about-top        { grid-template-columns: 1fr; gap: 2rem; }
  .about-cards      { grid-template-columns: 1fr; }
  .about-right-top  { grid-template-columns: 1fr; }
  .feature-row      { grid-template-columns: 1fr; gap: 0.4rem; }
  .mol-info-card    { position: static; margin-top: 1rem; }
}
</style>

<script>
  const io1 = new IntersectionObserver(
    e => e.forEach(x => { if (x.isIntersecting) { x.target.classList.add('visible'); io1.unobserve(x.target); } }),
    { threshold: 0.3 }
  );
  document.querySelectorAll('.stat-anim').forEach(el => io1.observe(el));

  const io2 = new IntersectionObserver(
    e => e.forEach(x => { if (x.isIntersecting) { x.target.classList.add('visible'); io2.unobserve(x.target); } }),
    { threshold: 0.1 }
  );
  document.querySelectorAll('.reveal-card').forEach(el => io2.observe(el));
</script>
