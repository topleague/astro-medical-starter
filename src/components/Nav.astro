---
const navLinks = [
  { href: '#services',    label: 'Servicios' },
  { href: '#about',       label: 'Sobre nosotros' },
  { href: '#team',        label: 'Equipo' },
  { href: '#contact',     label: 'Contacto' },
];
---
<!-- @daruma-template: Astro Medical Starter · https://darumaproducciones.es -->


<nav class="nav" id="nav">
  <a href="/" class="nav-logo">MEDCLINIC</a>

  <button class="nav-menu-btn" id="menuBtn" aria-label="Abrir menú">
    <span class="lines">
      <span></span>
      <span></span>
    </span>
    <span class="menu-label">Menu</span>
  </button>

  <div class="nav-icons">
    <!-- Buscar -->
    <button class="nav-icon-btn" aria-label="Buscar">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
    </button>
    <!-- Sound / CTA -->
    <a href="#contact" class="btn-accent" style="padding: 0.5rem 1.1rem; font-size:0.75rem;">
      Reservar cita
    </a>
  </div>
</nav>

<!-- Mobile Drawer -->
<div class="nav-drawer" id="navDrawer">
  {navLinks.map(l => <a href={l.href} class="drawer-link">{l.label}</a>)}
  <a href="#contact" class="btn-accent">Reservar cita</a>
</div>

<script>
  const nav      = document.getElementById('nav') as HTMLElement;
  const menuBtn  = document.getElementById('menuBtn') as HTMLButtonElement;
  const drawer   = document.getElementById('navDrawer') as HTMLElement;
  const drawerLinks = drawer.querySelectorAll('.drawer-link');

  // Scroll shadow
  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 40);
  });

  // Toggle drawer
  menuBtn.addEventListener('click', () => {
    const open = drawer.classList.toggle('open');
    menuBtn.setAttribute('aria-expanded', String(open));
  });

  // Close on link click
  drawerLinks.forEach(link => {
    link.addEventListener('click', () => drawer.classList.remove('open'));
  });
</script>

<style>
/* ── Nav mobile ────────────────────────────────────────── */
@media (max-width: 768px) {
  /* Ocultar texto "Menu" */
  .menu-label { display: none; }

  /* Ocultar el botón de búsqueda */
  .nav-icon-btn { display: none; }

  /* Botón reservar: texto centrado, tamaño adecuado */
  .nav-icons .btn-accent {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0.5rem 0.85rem;
    font-size: 0.72rem;
    line-height: 1.2;
  }
}
</style>

