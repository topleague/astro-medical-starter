---
import { getNavigationMenu } from '../lib/wordpress.js';

const navLinks = await getNavigationMenu('header-navigation');
---
<!-- @daruma-template: Astro Medical Starter · https://darumaproducciones.es -->

<nav class="nav" id="nav">
  <a href="/" class="nav-logo">MEDCLINIC</a>

  <button
    class="nav-menu-btn"
    id="menuBtn"
    aria-label="Abrir menú"
    aria-expanded="false"
  >
    <span class="lines">
      <span></span>
      <span></span>
    </span>
    <span class="menu-label">Menu</span>
  </button>

  <div class="nav-icons">
    <!-- Buscar -->
    <button class="nav-icon-btn" aria-label="Buscar">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.35-4.35" />
      </svg>
    </button>

    <!-- CTA -->
    <a
      href="#contact"
      class="btn-accent"
      style="padding: 0.5rem 1.1rem; font-size:0.75rem;"
    >
      Reservar cita
    </a>
  </div>
</nav>

<!-- Mobile Drawer -->
<div class="nav-drawer" id="navDrawer">
  {navLinks.map((link) => (
    <a href={link.url} class="drawer-link">
      {link.label}
    </a>
  ))}

  <a href="#contact" class="btn-accent">Reservar cita</a>
</div>

<script>
  const nav = document.getElementById('nav') as HTMLElement;
  const menuBtn = document.getElementById('menuBtn') as HTMLButtonElement;
  const drawer = document.getElementById('navDrawer') as HTMLElement;
  const drawerLinks = drawer.querySelectorAll('.drawer-link');

  // Scroll shadow
  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 40);
  });

  // Toggle drawer
  menuBtn.addEventListener('click', () => {
    const open = drawer.classList.toggle('open');

    menuBtn.setAttribute('aria-expanded', String(open));
  });

  // Close on link click
  drawerLinks.forEach((link) => {
    link.addEventListener('click', () => {
      drawer.classList.remove('open');
      menuBtn.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
/* ── Nav mobile ────────────────────────────────────────── */

@media (max-width: 768px) {
  /* Hide "Menu" text */
  .menu-label {
    display: none;
  }

  /* Hide search button */
  .nav-icon-btn {
    display: none;
  }

  /* Reserve button */
  .nav-icons .btn-accent {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0.5rem 0.85rem;
    font-size: 0.72rem;
    line-height: 1.2;
  }
}
</style>