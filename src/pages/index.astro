---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="MedClinic — Diagnóstico Médico Avanzado"
  description="Diagnósticos de salud de precisión y atención personalizada."
>

  <!-- ─────────────────────────────────────────
       INTRO
       ───────────────────────────────────────── -->

  <main>

    <section class="intro">

      <div class="intro-status">
        <span class="status-dot" aria-hidden="true"></span>
        Diagnóstico médico de precisión
      </div>

      <h1>
        Diagnóstico detallado<br />
        de tu cuerpo.
      </h1>

      <p class="intro-copy">
        La salud es lo más importante. No lo dejes para después.
        Piensa en tu futuro hoy.
      </p>

      <div class="intro-actions">
        <a href="#services" class="button button-solid">
          Ver servicios →
        </a>

        <a href="#contact" class="button button-ghost">
          Pedir cita
        </a>
      </div>

    </section>


    <!-- ─────────────────────────────────────────
         SERVICES
         ───────────────────────────────────────── -->

    <section id="services" class="section">

      <div class="section-heading">

        <div class="section-eyebrow">
          Servicios
        </div>

        <div class="section-count">
          04
        </div>

      </div>


      <div class="service-list">

        <a href="#contact" class="service-row">

          <span class="service-number">
            01
          </span>

          <div class="service-content">

            <h2>
              Diagnóstico genético
            </h2>

            <p>
              Análisis de precisión para comprender mejor
              tu salud y tus necesidades individuales.
            </p>

          </div>

          <span class="service-arrow">
            →
          </span>

        </a>


        <a href="#contact" class="service-row">

          <span class="service-number">
            02
          </span>

          <div class="service-content">

            <h2>
              Investigación oncológica
            </h2>

            <p>
              Investigación clínica especializada en
              oncología y diagnóstico del cáncer.
            </p>

          </div>

          <span class="service-arrow">
            →
          </span>

        </a>


        <a href="#contact" class="service-row">

          <span class="service-number">
            03
          </span>

          <div class="service-content">

            <h2>
              Diagnóstico corporal
            </h2>

            <p>
              Una visión integral del organismo mediante
              servicios avanzados de diagnóstico.
            </p>

          </div>

          <span class="service-arrow">
            →
          </span>

        </a>


        <a href="#contact" class="service-row">

          <span class="service-number">
            04
          </span>

          <div class="service-content">

            <h2>
              Atención personalizada
            </h2>

            <p>
              Un enfoque centrado en cada persona,
              sus necesidades y su futuro.
            </p>

          </div>

          <span class="service-arrow">
            →
          </span>

        </a>

      </div>

    </section>


    <!-- ─────────────────────────────────────────
         ABOUT
         ───────────────────────────────────────── -->

    <section id="about" class="section about-section">

      <div class="section-heading">

        <div class="section-eyebrow">
          Sobre MedClinic
        </div>

      </div>


      <div class="about-content">

        <p class="about-lead">
          La medicina de precisión empieza por entender
          tu cuerpo con mayor detalle.
        </p>

        <p class="about-copy">
          MedClinic combina diagnóstico avanzado,
          investigación clínica y atención personalizada
          para ofrecer una visión más completa de la salud.
        </p>

        <a href="#contact" class="text-link">
          Conoce nuestro enfoque →
        </a>

      </div>

    </section>


    <!-- ─────────────────────────────────────────
         CONTACT
         ───────────────────────────────────────── -->

    <section id="contact" class="section contact-section">

      <div class="section-heading">

        <div class="section-eyebrow">
          Hablemos
        </div>

      </div>


      <div class="contact-content">

        <h2>
          ¿Quieres conocer mejor<br />
          tu salud?
        </h2>

        <p>
          Estamos aquí para ayudarte a dar el siguiente paso.
        </p>

        <a href="mailto:info@medclinic.es" class="contact-link">
          info@medclinic.es →
        </a>

      </div>

    </section>

  </main>


  <!-- ─────────────────────────────────────────
       PAGE STYLES
       ───────────────────────────────────────── -->

  <style>

    main {
      padding-top: 5rem;
    }


    /* ─────────────────────────────────────────
       Shared
       ───────────────────────────────────────── */

    .intro,
    .section {
      width: min(100% - 3rem, 900px);
      margin-inline: auto;
    }


    /* ─────────────────────────────────────────
       Intro
       ───────────────────────────────────────── */

    .intro {
      padding-top: 7rem;
      padding-bottom: 8rem;
    }

    .intro-status {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;

      margin-bottom: 1.75rem;

      font-family: monospace;
      font-size: 0.72rem;
      letter-spacing: 0.04em;

      color: var(--color-muted);
    }

    .status-dot {
      width: 7px;
      height: 7px;

      border-radius: 50%;

      background: var(--color-grad-end);
    }

    .intro h1 {
      max-width: 720px;

      font-size: clamp(3rem, 7vw, 5.5rem);
      line-height: 0.98;

      font-weight: 600;

      letter-spacing: -0.045em;

      color: var(--color-text);
    }

    .intro-copy {
      max-width: 440px;

      margin-top: 2rem;

      font-size: 1rem;
      line-height: 1.7;

      color: var(--color-muted);
    }

    .intro-actions {
      display: flex;
      flex-wrap: wrap;

      gap: 0.75rem;

      margin-top: 2.5rem;
    }


    /* ─────────────────────────────────────────
       Buttons
       ───────────────────────────────────────── */

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      min-height: 42px;

      padding: 0.65rem 1.15rem;

      border-radius: 9999px;

      font-size: 0.78rem;
      font-weight: 600;

      text-decoration: none;

      transition:
        opacity 0.2s ease,
        background 0.2s ease,
        color 0.2s ease;
    }

    .button:hover {
      opacity: 0.72;
    }

    .button-solid {
      background: var(--color-text);
      color: #fff;
    }

    .button-ghost {
      border: 1px solid var(--color-border);
      color: var(--color-text);
      background: transparent;
    }


    /* ─────────────────────────────────────────
       Sections
       ───────────────────────────────────────── */

    .section {
      padding-bottom: 8rem;
    }

    .section-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;

      padding-bottom: 1.25rem;

      border-bottom: 1px solid var(--color-border);
    }

    .section-eyebrow {
      font-family: monospace;

      font-size: 0.7rem;

      letter-spacing: 0.06em;
      text-transform: uppercase;

      color: var(--color-muted);
    }

    .section-count {
      font-family: monospace;

      font-size: 0.7rem;

      color: var(--color-muted);
    }


    /* ─────────────────────────────────────────
       Services
       ───────────────────────────────────────── */

    .service-list {
      border-bottom: 1px solid var(--color-border);
    }

    .service-row {
      display: grid;

      grid-template-columns: 50px 1fr 30px;

      gap: 1.5rem;

      align-items: center;

      padding: 1.75rem 0;

      border-bottom: 1px solid var(--color-border);

      text-decoration: none;

      color: inherit;

      transition:
        padding-left 0.25s ease,
        opacity 0.25s ease;
    }

    .service-row:last-child {
      border-bottom: 0;
    }

    .service-row:hover {
      padding-left: 0.5rem;
    }

    .service-number {
      align-self: start;

      padding-top: 0.25rem;

      font-family: monospace;

      font-size: 0.72rem;

      color: var(--color-muted);
    }

    .service-content h2 {
      margin: 0;

      font-size: clamp(1.2rem, 2vw, 1.55rem);

      line-height: 1.25;

      font-weight: 600;

      letter-spacing: -0.02em;

      color: var(--color-text);
    }

    .service-content p {
      max-width: 480px;

      margin-top: 0.5rem;

      font-size: 0.84rem;

      line-height: 1.6;

      color: var(--color-muted);
    }

    .service-arrow {
      font-size: 1.1rem;

      color: var(--color-text);

      transition: transform 0.2s ease;
    }

    .service-row:hover .service-arrow {
      transform: translateX(4px);
    }


    /* ─────────────────────────────────────────
       About
       ───────────────────────────────────────── */

    .about-content {
      max-width: 700px;

      padding-top: 2.5rem;
    }

    .about-lead {
      max-width: 680px;

      font-size: clamp(1.8rem, 4vw, 3rem);

      line-height: 1.12;

      font-weight: 500;

      letter-spacing: -0.035em;

      color: var(--color-text);
    }

    .about-copy {
      max-width: 520px;

      margin-top: 2rem;

      font-size: 0.9rem;

      line-height: 1.7;

      color: var(--color-muted);
    }

    .text-link {
      display: inline-block;

      margin-top: 1.5rem;

      font-family: monospace;

      font-size: 0.75rem;

      color: var(--color-grad-end);

      text-decoration: none;
    }

    .text-link:hover {
      text-decoration: underline;
    }


    /* ─────────────────────────────────────────
       Contact
       ───────────────────────────────────────── */

    .contact-section {
      padding-bottom: 10rem;
    }

    .contact-content {
      padding-top: 2.5rem;
    }

    .contact-content h2 {
      max-width: 700px;

      font-size: clamp(2.3rem, 5vw, 4rem);

      line-height: 1.05;

      font-weight: 500;

      letter-spacing: -0.04em;

      color: var(--color-text);
    }

    .contact-content p {
      margin-top: 1.5rem;

      font-size: 0.9rem;

      color: var(--color-muted);
    }

    .contact-link {
      display: inline-flex;

      margin-top: 1.25rem;

      font-family: monospace;

      font-size: 0.85rem;

      color: var(--color-grad-end);

      text-decoration: none;
    }

    .contact-link:hover {
      text-decoration: underline;
    }


    /* ─────────────────────────────────────────
       Mobile
       ───────────────────────────────────────── */

    @media (max-width: 768px) {

      main {
        padding-top: 4.5rem;
      }

      .intro,
      .section {
        width: min(100% - 2rem, 900px);
      }

      .intro {
        padding-top: 5rem;
        padding-bottom: 6rem;
      }

      .intro h1 {
        font-size: clamp(2.7rem, 12vw, 4rem);
      }

      .intro-copy {
        font-size: 0.9rem;
      }

      .section {
        padding-bottom: 6rem;
      }

      .service-row {
        grid-template-columns: 35px 1fr 20px;

        gap: 0.75rem;

        padding: 1.4rem 0;
      }

      .service-content h2 {
        font-size: 1.15rem;
      }

      .service-content p {
        font-size: 0.8rem;
      }

      .about-lead {
        font-size: 2rem;
      }

      .contact-content h2 {
        font-size: 2.5rem;
      }

    }

  </style>

</BaseLayout>