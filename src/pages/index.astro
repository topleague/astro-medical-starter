---
import { getPosts } from '../lib/wordpress.js';

import BaseLayout from '../layouts/BaseLayout.astro';
import Nav         from '../components/Nav.astro';
import Hero        from '../components/Hero.astro';
import Marquee     from '../components/Marquee.astro';
import About       from '../components/About.astro';
import Services    from '../components/Services.astro';
import Advantages  from '../components/Advantages.astro';
import Team        from '../components/Team.astro';
import History     from '../components/History.astro';
import Contact     from '../components/Contact.astro';
import Footer      from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

const posts = await getPosts();

const marqueeItems = [
  'Salud de precisión',
  'Visión genética',
  'Investigación oncológica',
  'Atención personalizada',
  'Servicios de precisión',
];
---

<!-- @daruma-template: Astro Medical Starter · https://darumaproducciones.es -->

<BaseLayout
  title="MedClinic — Diagnóstico Médico Avanzado"
  description="Diagnósticos de salud de precisión y atención personalizada. Análisis genéticos, investigación oncológica y diagnóstico corporal completo."
>
  <Nav />
  <Hero />
  <Marquee items={marqueeItems} accent />
  <About />
  <Services />
  <Advantages />
  <Team />
  <History />
  <Contact />
  <Footer />
  <CookieBanner />

  <h2>WordPress Posts</h2>

  <ul>
    {posts.map((post) => (
      <li>
        <a href={post.uri}>{post.title}</a>
      </li>
    ))}
  </ul>
</BaseLayout>