---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getAllContentUris,
  getNodeByURI
} from '../lib/wordpress.js';

export async function getStaticPaths() {
  const uris = await getAllContentUris();

  return uris.map((uri) => ({
    params: {
      uri: uri.replace(/^\/|\/$/g, ''),
    },
    props: {
      uri,
    },
  }));
}

const { uri } = Astro.props;

const node = await getNodeByURI(uri);

if (!node) {
  return Astro.redirect('/404');
}

const isPost = node.__typename === 'Post';
const isPage = node.__typename === 'Page';
const isCategory = node.__typename === 'Category';
const isTag = node.__typename === 'Tag';
---

<BaseLayout
  title={node.title || node.name}
  description={node.excerpt || ''}
>
  <main class="post-page">
    <article class="post">

      {isPost && (
        <>
          <header class="post-header">
            <p class="post-date">
              {new Date(node.date).toLocaleDateString('en-IN', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </p>

            <h1>{node.title}</h1>

            <div
              class="post-excerpt"
              set:html={node.excerpt}
            />

            <div class="post-meta">

              {node.categories?.nodes?.length > 0 && (
                <div class="post-categories">
                  {node.categories.nodes.map((category) => (
                    <a href={category.uri}>
                      {category.name}
                    </a>
                  ))}
                </div>
              )}

              {node.tags?.nodes?.length > 0 && (
                <div class="post-tags">
                  {node.tags.nodes.map((tag) => (
                    <a href={tag.uri}>
                      {tag.name}
                    </a>
                  ))}
                </div>
              )}

            </div>
          </header>

          {node.featuredImage?.node && (
            <img
              class="post-featured-image"
              src={node.featuredImage.node.sourceUrl}
              alt={node.featuredImage.node.altText || node.title}
            />
          )}

          <div
            class="post-content"
            set:html={node.content}
          />
        </>
      )}

      {isPage && (
        <>
          <header class="post-header">
            <h1>{node.title}</h1>
          </header>

          <div
            class="post-content"
            set:html={node.content}
          />
        </>
      )}

      {(isCategory || isTag) && (
        <>
          <header class="post-header">
            <h1>{node.name}</h1>
          </header>

          <div class="post-list">
            {node.posts.nodes.map((item) => (
              <article>
                <h2>
                  <a href={item.uri}>{item.title}</a>
                </h2>

                <div set:html={item.excerpt} />
              </article>
            ))}
          </div>
        </>
      )}

    </article>
  </main>
</BaseLayout>

<style>
  .post-page {
    width: 100%;
    padding: 80px 24px;
  }

  .post {
    max-width: 820px;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: 48px;
  }

  .post-date {
    margin: 0 0 16px;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .post-header h1 {
    margin: 0 0 24px;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .post-excerpt {
    font-size: 1.2rem;
    line-height: 1.7;
    opacity: 0.75;
  }

  .post-meta {
    margin-top: 24px;
    font-size: 0.9rem;
  }

  .post-categories,
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }

  .post-categories a,
  .post-tags a {
    text-decoration: none;
    padding: 5px 10px;
    border: 1px solid currentColor;
    border-radius: 999px;
    opacity: 0.7;
  }

  .post-categories a:hover,
  .post-tags a:hover {
    opacity: 1;
  }

  .post-content {
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .post-content :global(p) {
    margin: 0 0 1.5rem;
  }

  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    margin: 3rem 0 1rem;
    line-height: 1.2;
  }

  .post-content :global(h2) {
    font-size: 2rem;
  }

  .post-content :global(h3) {
    font-size: 1.5rem;
  }

  .post-content :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-content :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 2.5rem auto;
  }

  .post-content :global(blockquote) {
    margin: 2.5rem 0;
    padding: 1rem 1.5rem;
    border-left: 4px solid currentColor;
    font-size: 1.05rem;
    opacity: 0.85;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-featured-image {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 0 48px;
    border-radius: 12px;
  }

  @media (max-width: 640px) {
    .post-page {
      padding: 48px 20px;
    }

    .post-header {
      margin-bottom: 36px;
    }

    .post-content {
      font-size: 1rem;
    }
  }
</style>