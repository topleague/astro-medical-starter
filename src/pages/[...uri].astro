---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/wordpress.js';

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post) => ({
    params: {
      uri: post.uri.replace(/^\/|\/$/g, ''),
    },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props;
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
>
  <main class="post-page">
    <article class="post">
      <header class="post-header">
        <p class="post-date">
          {new Date(post.date).toLocaleDateString('en-IN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </p>

        <h1>{post.title}</h1>

        <div
          class="post-excerpt"
          set:html={post.excerpt}
        />
      </header>

      <div
        class="post-content"
        set:html={post.content}
      />
    </article>
  </main>
</BaseLayout>

<style>
  .post-page {
    width: 100%;
    padding: 80px 24px;
  }

  .post {
    max-width: 820px;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: 48px;
  }

  .post-date {
    margin: 0 0 16px;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .post-header h1 {
    margin: 0 0 24px;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .post-excerpt {
    font-size: 1.2rem;
    line-height: 1.7;
    opacity: 0.75;
  }

  .post-content {
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .post-content :global(p) {
    margin: 0 0 1.5rem;
  }

  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    margin: 3rem 0 1rem;
    line-height: 1.2;
  }

  .post-content :global(h2) {
    font-size: 2rem;
  }

  .post-content :global(h3) {
    font-size: 1.5rem;
  }

  .post-content :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-content :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 2.5rem auto;
  }

  .post-content :global(blockquote) {
    margin: 2.5rem 0;
    padding: 1rem 1.5rem;
    border-left: 4px solid currentColor;
    font-size: 1.05rem;
    opacity: 0.85;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 640px) {
    .post-page {
      padding: 48px 20px;
    }

    .post-header {
      margin-bottom: 36px;
    }

    .post-content {
      font-size: 1rem;
    }
  }
</style>