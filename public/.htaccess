# ─── Compresión ───────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
  AddOutputFilterByType DEFLATE image/svg+xml application/json
</IfModule>

# ─── Caché de larga duración ──────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # Fuentes — 1 año (inmutables)
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType font/woff                     "access plus 1 year"

  # Imágenes
  ExpiresByType image/jpeg                    "access plus 1 month"
  ExpiresByType image/webp                    "access plus 1 month"
  ExpiresByType image/png                     "access plus 1 month"
  ExpiresByType image/svg+xml                 "access plus 1 month"

  # Vídeo
  ExpiresByType video/webm                    "access plus 1 month"
  ExpiresByType video/mp4                     "access plus 1 month"

  # CSS y JS (Astro genera hashes en los nombres → caché agresiva)
  ExpiresByType text/css                      "access plus 1 year"
  ExpiresByType application/javascript        "access plus 1 year"

  # HTML — sin caché (siempre fresco)
  ExpiresByType text/html                     "access plus 0 seconds"
</IfModule>

# ─── Cache-Control headers ────────────────────────────────
<IfModule mod_headers.c>
  # Fuentes: inmutables
  <FilesMatch "\.(woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imágenes y vídeo
  <FilesMatch "\.(jpg|jpeg|webp|png|svg|webm|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # CSS/JS con hash de Astro
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML: sin caché
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ─── MIME types ───────────────────────────────────────────
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType video/webm .webm
</IfModule>

# ─── Seguridad básica ─────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
